{
    "name": "feedmeai",
    "private": false,
    "version": "1.0.0",
    "type": "module",
    "description": "FeedMe AI - AI-powered recipe suggestion app that transforms your ingredients into delicious meals",
    "keywords": [
        "ai",
        "recipe",
        "cooking",
        "ingredients",
        "food",
        "openai",
        "react",
        "typescript",
        "vite"
    ],
    "author": {
        "name": "Victor Saly",
        "url": "https://victorsaly.com"
    },
    "license": "MIT",
    "homepage": "https://feedmeai.victorsaly.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/victorsaly/feedmeAI.git"
    },
    "bugs": {
        "url": "https://github.com/victorsaly/feedmeAI/issues"
    },
    "scripts": {
        "dev": "vite",
        "kill": "fuser -k 5000/tcp",
        "build": "tsc -b --noCheck && vite build && node scripts/build-sw.mjs",
        "lint": "eslint .",
        "optimize": "vite optimize",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "icons": "node scripts/make-icons.mjs",
        "ios:assets": "capacitor-assets generate --ios",
        "ios:sync": "npm run build && cap sync ios",
        "ios": "npm run ios:sync && cap open ios",
        "ios:ipa": "npm run ios:sync && cd ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Release -destination generic/platform=iOS -archivePath build/FeedMeAI.xcarchive -allowProvisioningUpdates archive && xcodebuild -exportArchive -archivePath build/FeedMeAI.xcarchive -exportOptionsPlist ../../store/ExportOptions.plist -exportPath build/export -allowProvisioningUpdates"
    },
    "dependencies": {
        "@capacitor-community/keep-awake": "^8.0.1",
        "@capacitor/camera": "^8.2.6",
        "@capacitor/core": "^8.6.2",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/ios": "^8.6.2",
        "@capacitor/local-notifications": "^8.3.1",
        "@capacitor/share": "^8.0.3",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.4",
        "@phosphor-icons/react": "^2.1.7",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-slot": "^1.1.2",
        "@tailwindcss/vite": "^4.1.11",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^3.6.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-error-boundary": "^6.0.0",
        "sonner": "^2.0.1",
        "tailwind-merge": "^3.0.2",
        "vaul": "^1.1.2"
    },
    "devDependencies": {
        "@capacitor/assets": "^4.0.0",
        "@capacitor/cli": "^8.6.2",
        "@eslint/js": "^9.21.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react-swc": "^3.10.1",
        "eslint": "^9.28.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jsdom": "^31.0.1",
        "tailwindcss": "^4.1.11",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.38.0",
        "vite": "^6.3.5",
        "vitest": "^5.1.1"
    }
}
