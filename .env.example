# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Add your key below (this file is gitignored for security)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Example:
# VITE_OPENAI_API_KEY=sk-proj-abcd1234...

# feedmeai-api — sign-in, the shopping list, and shopping search.
# Defaults to the deployed Worker; only needed to point at a local
# `wrangler dev` instance (see worker/README.md).
# VITE_FEEDME_API=http://localhost:8787